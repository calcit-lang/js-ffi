{
  "name": "@calcit/js-ffi",
  "private": true,
  "version": "0.1.5",
  "packageManager": "yarn@4.12.0",
  "dependencies": {
    "@calcit/procs": "^0.13.20"
  },
  "devDependencies": {
    "vite": "^8.0.12"
  },
  "scripts": {
    "check": "cr calcit.cirru --check-only",
    "check:node": "cr --entry node calcit.cirru --check-only",
    "check:browser": "cr --entry browser calcit.cirru --check-only",
    "compile:node": "cr --entry node calcit.cirru js",
    "run:node": "yarn compile:node && node node.mjs",
    "compile:browser": "cr --entry browser calcit.cirru js",
    "build:browser": "yarn compile:browser && yarn vite build --base=./",
    "serve:browser": "yarn vite --host 127.0.0.1",
    "run:browser": "yarn compile:browser && yarn vite --host 127.0.0.1",
    "format": "cr calcit.cirru edit format"
  }
}
