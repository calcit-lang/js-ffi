{
  "name": "@calcit/js-ffi",
  "private": true,
  "version": "0.1.13",
  "packageManager": "yarn@4.12.0",
  "dependencies": {
    "@calcit/procs": "0.13.77"
  },
  "devDependencies": {
    "vite": "^8.0.12"
  },
  "scripts": {
    "check": "calcit calcit.cirru --check-only",
    "check:quality": "calcit calcit.cirru analyze quality --baseline config/calcit-quality.cirru --format json",
    "audit:unsafe": "calcit calcit.cirru analyze weak-types --only unsafe-coerce --intent explicit-unsafe --format json",
    "check:node": "calcit --entry node calcit.cirru --check-only",
    "check:browser": "calcit --entry browser calcit.cirru --check-only",
    "compile:node": "calcit --entry node calcit.cirru js",
    "run:node": "yarn compile:node && node node.mjs",
    "test:contract:node": "yarn compile:node && node node-contract.mjs",
    "test:contract:browser-node": "yarn compile:browser && node browser-node-contract.mjs",
    "compile:browser": "calcit --entry browser calcit.cirru js",
    "build:browser": "yarn compile:browser && yarn vite build --base=./",
    "serve:browser": "yarn vite --host 127.0.0.1",
    "run:browser": "yarn compile:browser && yarn vite --host 127.0.0.1",
    "format": "calcit calcit.cirru edit format"
  }
}
